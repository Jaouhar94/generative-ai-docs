from flask import Flask, request, jsonify, send_file
from flask_cors import CORS
import librosa
import soundfile as sf
import numpy as np
import tensorflow as tf
import os

app = Flask(__name__)
CORS(app)

# تحميل نموذج المسترينغ المدرب مسبقًا
MODEL_PATH = "model.h5"
model = tf.keras.models.load_model(MODEL_PATH)

UPLOAD_FOLDER = "uploads"
PROCESSED_FOLDER = "processed"
os.makedirs(UPLOAD_FOLDER, exist_ok=True)
os.makedirs(PROCESSED_FOLDER, exist_ok=True)

@app.route("/mastering", methods=["POST"])
def mastering():
    if "file" not in request.files:
        return jsonify({"error": "لم يتم العثور على ملف"}), 400
    
    file = request.files["file"]
    filename = os.path.join(UPLOAD_FOLDER, file.filename)
    processed_filename = os.path.join(PROCESSED_FOLDER, "mastered_" + file.filename)

    file.save(filename)

    # تحميل الملف الصوتي وتحويله إلى شكل مناسب للنموذج
    audio, sr = librosa.load(filename, sr=44100)
    audio = np.expand_dims(audio, axis=0)

    # تطبيق المسترينغ باستخدام النموذج
    processed_audio = model.predict(audio)[0]

    # حفظ الملف المسترّ
    sf.write(processed_filename, processed_audio, sr)

    return send_file(processed_filename, as_attachment=True)

@app.route("/")
def home():
    return "QOVOQAL AI Mastering API is running!"

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000, debug=True) 
